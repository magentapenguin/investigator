		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@ai-sdk/svelte": "^5.0.83",
		"@lucide/svelte": "^1.35.0",
		"@magenta/utills": "^0.0.2",
		"@openrouter/ai-sdk-provider": "^3.0.0",
		"@twemoji/api": "^17.0.3",
		"ai": "^7.0.83",
		"better-sqlite3": "^13.0.2",
		"inter-ui": "^4.1.1",
		"jsdom": "^30.0.1",
		"svelte-exmarkdown": "^5.0.2",
		"zod": "^4.4.3"
	}
}
